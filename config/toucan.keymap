#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define M_MOUSE 1
#define FUNCTION 2
#define NUMBER 3
#define SCROLL 4
#define MEDIA_BT 5

/ {
    macros {
        zoom_in_wheel: zoom_in_wheel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &msc SCRL_UP>,
                <&macro_release>,
                <&msc SCRL_UP &kp LCTRL>;
        };

        zoom_out_wheel: zoom_out_wheel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &msc SCRL_DOWN>,
                <&macro_release>,
                <&msc SCRL_DOWN &kp LCTRL>;
        };
    };

    behaviors {
        td_lang: td_language2_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LANGUAGE_2>, <&kp LANGUAGE_1>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        media_bt {
            if-layers = <FUNCTION NUMBER>;
            then-layer = <MEDIA_BT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "DEFAULT";
            bindings = <
                &kp LALT  &kp Q &kp W &lt SCROLL E &kp R &kp T   &kp Y &kp U &lt SCROLL I &kp O &kp P &kp DELETE
                &kp LCTRL &kp A &kp S &kp D         &kp F &kp G   &kp H &kp J &kp K        &kp L &kp SEMI &lt M_MOUSE SQT
                &kp LSHFT &kp Z &kp X &kp C         &kp V &kp B   &kp N &kp M &kp COMMA    &kp DOT &kp FSLH &kp ESC
                                      &td_lang &lt FUNCTION SPACE &lt M_MOUSE TAB   &kp BSPC &lt NUMBER ENTER &kp RIGHT_WIN
            >;
        };

        m_mouse {
            display-name = "M_MOUSE";
            bindings = <
                &trans &kp LC(LS(TAB))  &kp UP    &kp LC(TAB)        &zoom_in_wheel    &trans   &trans &kp HOME &trans    &kp PAGE_UP   &kp RALT &trans
                &trans &kp LEFT         &kp DOWN  &kp RIGHT          &trans            &trans   &trans &trans   &mkp MB1  &trans        &mkp MB2 &kp RCTRL
                &trans &kp LS(LG(LEFT)) &trans    &kp LS(LG(RIGHT)) &zoom_out_wheel   &trans   &trans &trans   &kp END   &mkp MB4      &kp PAGE_DOWN &kp RIGHT_SHIFT
                                             &trans &trans &trans   &trans &trans &trans
            >;
        };

        function {
            display-name = "FUNCTION";
            bindings = <
                &trans    &kp LALT  &kp F7 &kp F8 &kp F9 &kp F12   &kp AT   &kp TILDE &kp LBRC &kp RBRC &kp SEMI &trans
                &kp LCTRL &kp F4    &kp F5 &kp F6 &kp F11 &trans   &trans   &kp HASH  &kp MINUS &kp LBKT &kp RBKT &kp COLON
                &kp LSHFT &kp F1    &kp F2 &kp F3 &kp F10 &kp F13  &trans   &kp AMPS  &kp UNDER &kp LPAR &kp RPAR &kp BSLH
                                            &trans &trans &trans   &trans &trans &trans
            >;
        };

        number {
            display-name = "NUMBER";
            bindings = <
                &trans &kp KP_PLUS     &kp KP_NUMBER_7 &kp KP_NUMBER_8 &kp KP_NUMBER_9 &kp KP_MINUS   &trans &kp HOME &kp UP    &kp PAGE_UP   &kp RALT &trans
                &trans &kp KP_ASTERISK &kp KP_NUMBER_4 &kp KP_NUMBER_5 &kp KP_NUMBER_6 &kp KP_SLASH   &trans &trans   &kp LEFT  &kp DOWN      &kp RIGHT &trans
                &trans &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_3 &kp KP_DOT     &kp EQUAL &trans &kp END &none         &kp PAGE_DOWN &kp DLLR
                                               &trans &trans &trans   &trans &trans &trans
            >;
        };

        scroll {
            display-name = "SCROLL";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                                    &trans &trans &trans   &trans &trans &trans
            >;
        };

        media_bt {
            display-name = "MEDIA_BT";
            bindings = <
                &studio_unlock &trans &trans &trans &trans &kp C_VOL_UP   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans
                &trans &trans &trans &trans &trans &kp C_MUTE            &trans &bootloader &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &kp C_VOL_DN          &trans &sys_reset &trans &trans &trans &bt BT_CLR
                                      &trans &trans &trans   &trans &trans &bt BT_CLR_ALL
            >;
        };
    };
};
